generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  clerkUserId String    @unique
  name        String?
  email       String    @unique
  imageUrl    String?
  dateOfBirth DateTime?
  onboarded   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  familyMembers  FamilyMember[]
  appointments   Appointment[]
  medicines      Medicine[]
  conversations  Conversation[]
  notifications  Notification[]
  subscription   Subscription?
  timelineEvents TimelineEvent[]
  reports        MedicalReport[]

  @@index([clerkUserId])
}

model FamilyMember {
  id           String    @id @default(cuid())
  userId       String
  name         String
  relationship String
  dateOfBirth  DateTime?
  gender       String?
  imageUrl     String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalReports MedicalReport[]
  appointments   Appointment[]
  medicines      Medicine[]
  timelineEvents TimelineEvent[]

  @@index([userId])
}

model MedicalReport {
  id               String   @id @default(cuid())
  userId           String
  familyMemberId   String
  fileUrl          String?
  fileName         String?
  fileType         String?
  fileSize         Int?
  reportType       String
  reportDate       DateTime
  extractedText    String?
  aiSummary        String?
  aiQuestions      String?
  processingStatus String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember    @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  metrics        ReportMetric[]
  timelineEvents TimelineEvent[]

  @@index([userId])
  @@index([familyMemberId])
}

model ReportMetric {
  id             String   @id @default(cuid())
  reportId       String
  familyMemberId String
  userId         String
  testName       String
  value          Float?
  valueText      String?
  unit           String?
  referenceRange String?
  isOutOfRange   Boolean  @default(false)
  isUncertain    Boolean  @default(false)
  reportDate     DateTime
  createdAt      DateTime @default(now())

  report MedicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([familyMemberId])
  @@index([userId])
}

model Appointment {
  id             String   @id @default(cuid())
  userId         String
  familyMemberId String
  doctorName     String
  specialty      String?
  date           DateTime
  time           String?
  location       String?
  notes          String?
  status         String   @default("upcoming")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember    @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  timelineEvents TimelineEvent[]

  @@index([userId])
  @@index([familyMemberId])
}

model Medicine {
  id             String    @id @default(cuid())
  userId         String
  familyMemberId String
  name           String
  dosage         String?
  frequency      String?
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember    @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  timelineEvents TimelineEvent[]

  @@index([userId])
  @@index([familyMemberId])
}

model TimelineEvent {
  id             String   @id @default(cuid())
  userId         String
  familyMemberId String
  type           String
  title          String
  description    String?
  eventDate      DateTime
  reportId       String?
  appointmentId  String?
  medicineId     String?
  createdAt      DateTime @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyMember FamilyMember   @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  report       MedicalReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  appointment  Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  medicine     Medicine?      @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@index([familyMemberId])
  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  plan                   String    @default("free")
  status                 String    @default("active")
  razorpaySubscriptionId String?
  razorpayCustomerId     String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  aiAnalysesUsed         Int       @default(0)
  aiAnalysesLimit        Int       @default(2)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
